# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (development/testing — file path)
DATABASE_PATH=./data/flowledger.db

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_256_bit_random_string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=90d

# ─── Plaid ────────────────────────────────────────────────────────────────────
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
# Options: sandbox | development | production
PLAID_ENV=sandbox

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_MONTHLY_PRICE_ID=price_monthly_xxx
STRIPE_ANNUAL_PRICE_ID=price_annual_xxx

# ─── App URLs ─────────────────────────────────────────────────────────────────
APP_URL=https://flowledger.com
API_URL=https://api.flowledger.com
STRIPE_SUCCESS_URL=https://flowledger.com/upgrade/success
STRIPE_CANCEL_URL=https://flowledger.com/upgrade
