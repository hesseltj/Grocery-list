# FlowLedger — Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# Variables prefixed with EXPO_PUBLIC_ are bundled into the app.

# Your deployed backend API URL (Railway, Render, etc.)
EXPO_PUBLIC_API_BASE_URL=https://YOUR_RAILWAY_URL/v1

# Sentry DSN for error tracking (get from sentry.io → Project → Settings → Client Keys)
EXPO_PUBLIC_SENTRY_DSN=https://YOUR_KEY@sentry.io/YOUR_PROJECT_ID

# PostHog analytics (get from posthog.com → Project → Settings → Project API Key)
EXPO_PUBLIC_POSTHOG_KEY=phc_YOUR_POSTHOG_KEY
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
